# --- Local native build & backup scratch (never commit) ---
cpp_build*/
backup_*/

# --- Root-level scratch/debug files (added for clean git backup) ---
*.txt
*.log
# ...but CMakeLists.txt is a build script, not scratch. The *.txt rule above
# silently excluded app/src/main/cpp/CMakeLists.txt and
# analyzer/src/main/cpp/CMakeLists.txt from version control, which means the
# native build could not be reproduced from a fresh clone. Keep them tracked.
!**/CMakeLists.txt
adb_*.py
check_*.py
dump*.py
fix_*.py
find_*.py
scan_*.py
read_*.py
inspect_*.py
analyze_*.py
sample_*.py
count_*.py
diff*.py
cmp_*.py
grep_*.py
audit_*.py
clean_*.py
cn_*.py
translate*.py
_*.py
trace*.txt
build*.bat

