<Slide style={{ width: '1280px', height: '720px', background: '#0B1120', position: 'relative', overflow: 'hidden', fontFamily: "'Inter', 'PingFang SC', 'Microsoft YaHei', sans-serif" }}>
  <Box style={{ position: 'absolute', bottom: -120, right: -90, width: 380, height: 380, borderRadius: '50%', background: 'linear-gradient(135deg, #3B82F6 0%, #22D3EE 100%)', opacity: 0.07 }} />
  <Box style={{ flexDirection: 'row', height: '100%', paddingTop: 40, paddingBottom: 40, paddingLeft: 64, paddingRight: 64 }}>
    <Box style={{ width: '30%', paddingRight: 36, justifyContent: 'center' }}>
      <Box style={{ width: 40, height: 5, background: 'linear-gradient(135deg, #3B82F6, #22D3EE)' }} />
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E5EDF7', marginTop: 18, lineHeight: 1.2 }}>进阶模块</Text>
      <Text style={{ fontSize: 16, color: '#8DA2BC', marginTop: 18, lineHeight: 1.6 }}>滑块之外的一组专业音效，按需开启。</Text>
    </Box>
    <Box style={{ width: '70%', justifyContent: 'center', gap: 9 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="sliders-h" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>动态压缩器 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Dynamic Compressor</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>压平忽大忽小，通勤 / 车载更稳</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="volume-up" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>等响补偿 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Loudness</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>小音量自动补低频高频（ISO 226）</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="headphones" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>Crossfeed <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>串扰</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>耳机减「头中效应」疲劳（仅耳机）</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="wave-square" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>空间混响 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Space Reverb</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>程序化房间尾音，偏现场 / 交响</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="equalizer" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>动态 EQ <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Dynamic EQ</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>分频段压缩，修蓝牙高频瞬态</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="shield" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>多段限幅 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Limiter</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>低 / 中 / 高独立限幅防破音</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="magic" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>AutoEQ 校正 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Correction</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>你的调音 ↔ 完整校正 之间混合</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="broadcast-tower" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>DTS 环绕 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Surround</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>环绕 / 高度，建议 LDAC / LHDC</Text></Box></Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, padding: 10, background: '#13203A', borderRadius: 10, border: '1px solid rgba(255,255,255,0.06)' }}><FAIcon name="microchip" style={{ fill: '#22D3EE', width: 26, height: 26 }} /><Box><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#E5EDF7' }}>设备自动校准 <Text style={{ fontSize: 13, color: '#8DA2BC', fontWeight: 'normal' }}>Auto-Calibration</Text></Text><Text style={{ fontSize: 14, color: '#8DA2BC' }}>自动套用当前耳机 / DAC 曲线</Text></Box></Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 32, left: 64, right: 64, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5C6B82' }}>MSEB 攻略</Text>
    <Text style={{ fontSize: 14, color: '#5C6B82' }}>06 / 10</Text>
  </Box>
</Slide>
